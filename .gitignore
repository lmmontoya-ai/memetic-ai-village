# Generated research trees are private by default. Add public outputs deliberately.
# This also covers future stages, populated labels, model responses, and invalid runs.
/data/**
!/data/**/
!/data/raw_manifest/dataset_manifest.json
!/data/raw_manifest/holdout.json
/data/raw_manifest/snapshot/
/data/raw_manifest/selected_screenshots_v2/
/data/interim/
/data/processed/

/annotations/**
!/annotations/**/
!/annotations/**/README.md
!/annotations/**/annotation_codebook*.md
/annotations/**/machine/
/annotations/**/packets/
/annotations/**/private/
/annotations/**/full_traces/

/episodes/**
!/episodes/README.md
!/episodes/LEGACY_V1_INVALID_PROXY.md

# Only explicitly reviewed aggregate outputs belong in the public repository.
/reports/**
!/reports/README.md
!/reports/public_results_v2_2.json
!/reports/machine_annotation_preliminary_v2_2.md
!/reports/pre_annotation_freeze_v2_2.json
!/reports/verification_v2_2.json
!/reports/protocol_integrity_review.json
!/reports/yaml_blank_line_truth_audit_v2_2.json
!/reports/repository_review.md

# Bulk data stay local even if a script chooses a different output directory.
*.parquet
*.duckdb
*.duckdb.wal
*.jsonl
*.jsonl.gz
*.json.gz
*.tar
*.tar.gz
*.zip
